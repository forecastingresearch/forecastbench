FROM REGION-docker.pkg.dev/serverless-runtimes/STACK/runtimes/PYTHON_VERSION
COPY --from=ghcr.io/astral-sh/uv:UV_VERSION /uv /bin/uv

RUN whoami || echo "whoami not found"

USER root
RUN apt-get update && apt-get install -y git openssh-client
USER www-data

COPY --chown=www-data:www-data . /app

WORKDIR /app

# Install this job's locked dependency group into /app/.venv with the image's Python.
RUN UV_PYTHON_DOWNLOADS=never uv sync --locked --no-cache --only-group DEPENDENCY_GROUP
ENV PATH="/app/.venv/bin:$PATH"

CMD ["python3", "main.py"]
